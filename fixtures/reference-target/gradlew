# Gradle start-up script for POSIX-compliant shells. Regenerate the accompanying
# gradle-wrapper.jar with `gradle wrapper` if it is not present.

set -e

APP_HOME=$( cd "$( dirname "$0" )" >/dev/null 2>&1 && pwd )
APP_BASE_NAME=$( basename "$0" )
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1 ; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command could be found." >&2
    exit 1
fi

exec "$JAVACMD" ${JAVA_OPTS} ${GRADLE_OPTS} \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
