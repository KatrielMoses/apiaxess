# Rust and JavaScript build outputs.
/target/
node_modules/
/apps/gui/dist/
/apps/gui/.vite/
/apps/desktop/gen/

# Android build products (the Android project also carries its local rules).
/apps/android/artifacts/
*.apk
*.apkm
*.aab

# Installer packages are produced by packaging scripts, never checked in.
*.deb
*.msi

# Local work areas and disposable intake/output artifacts.
/artifacts/
/apiaxess-artifacts/
/testers/
/tmp/
/Delzyn/
/_patch_test.txt
*.session

# Local proxy CA state and material are generated per machine/session.
*.ca-state
*.ca-state.*
ca-state/

# IDE and OS metadata.
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Raw brand identity kit bundle: referenced locally, never committed.
# The extracted, durable brand values live in apps/gui/src/styles/tokens.css
# and apps/gui/src/brand/, which are committed.
/assets/brand/*.html

# Bundled third-party tool payloads: fetched by packaging, never committed.
/tools/jadx-*/
/tools/*.zip
/tools/ffuf/
/tools/java-runtime/
/tools/jre/
/tools/chromium/
/tools/frida/
/tools/analysis-runtime/

# Large third-party copyrighted APK test fixtures: exceed GitHub's file limit and
# are provided out-of-band for the capstone/bundled integration tests.
/fixtures/capstone/*.apk
/fixtures/capstone/*.apkm

# WiX installer build output
.wix/

# Local GUI/UX regression test skill — invoked in-repo, never published.
/.claude/skills/test-apiaxess/

# gstack browse-daemon local state (tool artifact, never committed).
/.gstack/

# Internal docs — not for the public repo
/PRODUCT-FACTS.md
/architecture-audit.md

# local README preview (not committed)
/readme-preview.html
/logo-check.html
