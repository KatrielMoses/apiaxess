{
    "version": "0.1.0",
    "description": "Open-source security workbench that recovers an app's API from APKs, live traffic, and HAR files.",
    "homepage": "https://apiaxess.dev",
    "license": "Apache-2.0",
    "notes": "User data lives in %LOCALAPPDATA%\\apiaxess and is kept on uninstall.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KatrielMoses/apiaxess/releases/download/v0.1.0/APIaxess-0.1.0-windows-x64-portable.zip",
            "hash": "5010da7cf36c8004c54d76812e2b37244a072bc874e2dd96330f70e68776fe7e"
        }
    },
    "bin": "bin\\apiaxess.exe",
    "post_install": [
        "Set-Content -LiteralPath \"$dir\\install-channel\" -Value scoop -NoNewline -Encoding ascii"
    ],
    "shortcuts": [
        [
            "bin\\apiaxess-desktop.exe",
            "APIaxess"
        ]
    ],
    "checkver": {
        "github": "https://github.com/KatrielMoses/apiaxess"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KatrielMoses/apiaxess/releases/download/v$version/APIaxess-$version-windows-x64-portable.zip",
                "hash": {
                    "url": "https://github.com/KatrielMoses/apiaxess/releases/download/v$version/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                }
            }
        }
    }
}
