  <metadata>
    <id>apiaxess</id>
    <version>0.1.0</version>
    <title>APIaxess</title>
    <authors>APIaxess</authors>
    <owners>KatrielMoses</owners>
    <projectUrl>https://apiaxess.dev</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/KatrielMoses/apiaxess/main/apps/desktop/icons/128x128.png</iconUrl>
    <licenseUrl>https://github.com/KatrielMoses/apiaxess/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/KatrielMoses/apiaxess</projectSourceUrl>
    <packageSourceUrl>https://github.com/KatrielMoses/apiaxess/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://github.com/KatrielMoses/apiaxess#readme</docsUrl>
