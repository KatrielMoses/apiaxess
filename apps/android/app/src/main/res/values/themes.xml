<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the entire UI; this XML theme only sets the window chrome to
         the dark identity surface so there is no white flash before first frame. -->
    <style name="Theme.ApiaxessClient" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
